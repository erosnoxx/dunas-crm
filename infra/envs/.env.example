# =============================================================================
# crm: variaveis do stack de desenvolvimento (Docker)
# =============================================================================
#
# Modelo versionado. Copie para .env.dev, nesta mesma pasta, e ajuste:
#
#     copy .env.example .env.dev
#
# O .env.dev NUNCA vai para o git (.gitignore da raiz). Quem le o .env.dev sao os scripts de
# infra\scripts (dev-up, dev-down, dev-logs) e, por eles, o infra/docker/compose.dev.yml.
#
# Valores entre aspas simples sao literais (nada de $ ou \ e interpretado).


# --- Portas no host ----------------------------------------------------------
# So mude se a porta ja estiver ocupada na sua maquina. FRONTEND_HOST_PORT tambem vira a base
# dos links dos e-mails de convite e de redefinicao de senha.
FRONTEND_HOST_PORT=8090
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBIT_HOST_PORT=5672
RABBIT_UI_HOST_PORT=15672
MAILPIT_UI_HOST_PORT=8025


# --- Postgres ----------------------------------------------------------------
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=crm


# --- RabbitMQ ----------------------------------------------------------------
RABBIT_USER=crm
RABBIT_PASSWORD=crm


# --- E-mail ------------------------------------------------------------------
# Todo e-mail da API vai para o Mailpit (http://localhost:8025); nada sai da maquina.
EMAIL_FROM='CRM <no-reply@crm.local>'


# --- Administrador inicial (IAM) ---------------------------------------------
# Criado no primeiro boot, so se o banco nao tem nenhum usuario. A conta nasce com troca de
# senha obrigatoria no primeiro acesso. A senha segue a regra do dominio: 8 a 30 caracteres,
# com maiuscula, minuscula, numero e caractere especial, e nao pode conter "${".
CRM_ADMIN_NAME='Administrador'
CRM_ADMIN_EMAIL=admin@crm.local
CRM_ADMIN_PASSWORD='Crm#Dev2026'
